PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=localhost
DB_USER=task_app
DB_PASSWORD=your_local_password
DB_NAME=student_task_manager
JWT_SECRET=change_this_to_a_long_random_string

# Google sign-in + Google Calendar (see README, "Google setup")
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
# Encrypts stored Google refresh tokens. Use 32+ random characters (e.g. `openssl rand -hex 32`).
# TOKEN_ENCRYPTION_KEY=change_this_to_another_long_random_string

# Optional image storage. See README.md.
# S3_BUCKET=task-manager-images
# S3_ENDPOINT=http://127.0.0.1:4569
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=S3RVER
# AWS_SECRET_ACCESS_KEY=S3RVER
